# Student Hub Environment Configuration Example

NEXT_PUBLIC_APP_NAME="Student Hub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Session Secret
SESSION_SECRET="your-32-character-secret-key-goes-here-change-in-prod"

# Database: Optional external PostgreSQL connection string (e.g. postgresql://user:pass@localhost:5432/studenthub)
# If left empty, Student Hub will run with its built-in zero-config PostgreSQL engine saving to ./data/pgdata
DATABASE_URL=""
PGLITE_DATA_DIR="./data/pgdata"

# AI Tutor Configuration
# AI_PROVIDER: gemini (real responses) | mock (canned replies, no key needed)
# When AI_PROVIDER=gemini but AI_API_KEY is empty, the app falls back to mock automatically.
# Get a free Gemini key at https://aistudio.google.com/apikey
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL_NAME="gemini-2.5-flash"
FREE_TIER_DAILY_AI_LIMIT="20"
